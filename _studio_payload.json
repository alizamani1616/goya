"<!DOCTYPE html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>گویا استودیو</title>\n<link rel=\"icon\" type=\"image/png\" href=\"../ide_static/favicon.png\">\n<link rel=\"preconnect\" href=\"https://cdn.jsdelivr.net\">\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css\" media=\"print\" onload=\"this.media='all'\">\n<style>\n:root{\n  --bg:#FFF3E4; --card:#ffffff; --text:#1E2A4A; --muted:#8A93A6;\n  --purple:#7048E8; --purple2:#9775FA; --coral:#E5484D;\n  --tint-blue:#E3F2FF; --tint-violet:#F1EDFF; --tint-yellow:#FFF6DC; --tint-mint:#E4FAF0;\n  --line:rgba(30,42,74,.12); --plain:#1E2A4A;\n  --kw:#E5484D; --built:#7048E8; --str:#0CA678; --num:#3B82F6;\n  --cmt:#9AA3B8; --opw:#F76707;\n  --code-size:16px;\n}\n[data-theme=\"dark\"]{\n  --bg:#111827; --card:#18213A; --text:#F8FAFC; --muted:#CBD5E1;\n  --tint-blue:#17263F; --tint-violet:#221E44; --tint-yellow:#2B2517; --tint-mint:#113227;\n  --kw:#FF8787; --built:#9775FA; --str:#38D9A9; --num:#74C0FC;\n  --cmt:#64748B; --opw:#FFA94D; --plain:#E2E8F0;\n  --line:rgba(248,250,252,.10);\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--text);font-family:Vazirmatn,'Segoe UI',Tahoma,sans-serif;min-height:100vh}\nheader{display:flex;align-items:center;gap:12px;padding:12px 22px 8px}\n.logo-img{height:52px;display:block}\n.brand{font-size:22px;font-weight:900}\n#projName{font:700 14px Vazirmatn,Tahoma;border:1.5px solid var(--line);background:var(--card);color:var(--text);border-radius:10px;padding:7px 12px;width:200px;text-align:center;outline:none}\n.spacer{flex:1}\n.tbtn{display:inline-flex;align-items:center;gap:6px;background:var(--card);border:1.5px solid var(--line);color:var(--text);border-radius:999px;padding:7px 14px;font:600 13.5px Vazirmatn,Tahoma;cursor:pointer;transition:.13s}\n.tbtn:hover{border-color:var(--purple2)}\n.tbtn img{width:16px;height:16px}\n.cicon{width:16px;height:16px}\n.tbtn.run{background:linear-gradient(135deg,var(--purple),var(--purple2));color:#fff;border:0;box-shadow:0 4px 14px rgba(112,72,232,.35);padding:9px 22px;font-weight:800}\n.tbtn.run:disabled{opacity:.6;cursor:wait}\n\n.tabbar{position:relative;z-index:1;max-width:1500px;margin:0 auto;padding:0 18px;display:flex;gap:6px}\n.tabbtn2{border:1.5px solid var(--line);border-bottom:0;background:var(--card);color:var(--muted);border-radius:14px 14px 0 0;padding:9px 26px;font:700 14.5px Vazirmatn,Tahoma;cursor:pointer}\n.tabbtn2.on{color:var(--purple);background:var(--card);border-bottom:2.5px solid var(--purple)}\n\nmain{position:relative;z-index:1;max-width:1500px;margin:0 auto;padding:0 18px 18px}\n.view{display:none}\n.view.on{display:block}\n\n/* ───── طراح ───── */\n.designer{display:grid;grid-template-columns:200px 1fr 250px;gap:14px}\n.panel{background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden}\n.panel h3{margin:0;padding:11px 14px;font-size:13.5px;background:var(--tint-violet);display:flex;gap:7px;align-items:center}\n.tools{display:flex;flex-direction:column;gap:8px;padding:12px}\n.tool{display:flex;align-items:center;gap:10px;border:1.5px solid var(--line);border-radius:12px;padding:9px 12px;cursor:grab;background:var(--card);transition:.12s;font-weight:700;font-size:14px}\n.tool:hover{border-color:var(--purple2);transform:translateY(-1px)}\n.tool.placing{border-style:solid;border-color:var(--purple);background:var(--tint-violet)}\n.tool .tico{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900}\n.canvas-wrap{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;overflow:auto;display:flex;justify-content:center;align-items:flex-start;min-height:560px}\n.form-window{background:#F8FAFC;border-radius:10px;box-shadow:0 10px 34px rgba(60,40,120,.18);position:relative;overflow:hidden}\n.form-title{height:34px;display:flex;align-items:center;padding:0 12px;font-weight:700;font-size:13px;color:#fff}\n.ctrl{position:absolute;cursor:move;user-select:none;font-family:Vazirmatn,Tahoma}\n.ctrl.btn-c{background:linear-gradient(135deg,#7048E8,#9775FA);color:#fff;border-radius:9px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13.5px;box-shadow:0 3px 9px rgba(112,72,232,.30)}\n.ctrl.label-c{color:#1E2A4A;font-weight:700;font-size:13.5px;display:flex;align-items:center}\n.ctrl.entry-c{background:#fff;border:1.5px solid #C7CDD8;border-radius:8px;color:#1E2A4A;display:flex;align-items:center;padding:0 8px;font-size:13px;color-mute:#8A93A6}\n.ctrl.sel{outline:3px solid #2DD4BF;outline-offset:1px}\n.props{display:flex;flex-direction:column;gap:10px;padding:14px}\n.prow{display:flex;flex-direction:column;gap:4px}\n.prow label{font-size:12.5px;color:var(--muted);font-weight:700}\n.prow input{border:1.5px solid var(--line);border-radius:9px;padding:7px 10px;font:600 13.5px Vazirmatn,Tahoma;background:var(--code-bg,#fff);color:var(--text);outline:none;width:100%}\n.prow input:focus{border-color:var(--purple2)}\n.pnote{font-size:12px;color:var(--muted);line-height:1.9}\n\n/* ───── کد ───── */\n.editor-wrap{display:flex;height:560px;background:#FDFCFF;border-radius:0 0 16px 16px;overflow:hidden}\n.gutter{width:46px;padding:14px 6px 14px 0;text-align:center;color:var(--gutter-num,#A79EF0);font:600 var(--code-size)/1.9 Vazirmatn,Tahoma;overflow:hidden;user-select:none;background:var(--tint-violet);flex-shrink:0}\n.code-area{position:relative;flex:1;direction:rtl}\n.code-layer{margin:0;padding:14px 16px;font:500 var(--code-size)/1.9 Vazirmatn,Tahoma;white-space:pre-wrap;word-wrap:break-word;direction:rtl;text-align:right;border:0}\n#hl{position:absolute;inset:0;overflow:hidden;pointer-events:none;color:var(--plain)}\n#codeTa{position:absolute;inset:0;width:100%;height:100%;background:transparent;color:transparent;caret-color:var(--caret,#7048E8);resize:none;outline:none;overflow:auto}\n#codeTa::selection{background:rgba(112,72,232,.18)}\n.tk-kw{color:var(--kw);font-weight:800}\n.tk-built{color:var(--built);font-weight:800}\n.tk-str{color:var(--str);font-weight:600}\n.tk-num{color:var(--num);font-weight:700}\n.tk-cmt{color:var(--cmt);font-style:italic}\n.tk-opw{color:var(--opw);font-weight:700}\n\n/* ───── خروجی ───── */\n.out-card{margin-top:14px;background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden}\n#out{margin:0;padding:14px 18px;background:#111827;color:#F8FAFC;font:500 14px/1.9 Vazirmatn,Tahoma;white-space:pre-wrap;direction:rtl;text-align:right;min-height:90px;max-height:220px;overflow:auto}\n.hintbar{padding:7px 16px;font-size:12px;color:var(--muted);border-top:1px solid var(--line);display:flex;justify-content:space-between}\n</style>\n</head>\n<body>\n\n<header>\n  <img class=\"logo-img\" src=\"../ide_static/logo.png\" alt=\"گویا\">\n  <div class=\"brand\">گویا استودیو</div>\n  <input id=\"projName\" value=\"برنامه بدون نام\" spellcheck=\"false\">\n  <div class=\"spacer\"></div>\n  <button class=\"tbtn\" id=\"newBtn\"><img src=\"../ide_static/icons/file.webp\" alt=\"\">جدید</button>\n  <button class=\"tbtn\" id=\"openBtn\"><img src=\"../ide_static/icons/bulb.webp\" alt=\"\">باز کردن</button>\n  <button class=\"tbtn\" id=\"saveBtn\"><img src=\"../ide_static/icons/download.webp\" alt=\"\">ذخیره</button>\n  <button class=\"tbtn run\" id=\"runBtn\"><img src=\"../ide_static/icons/play.webp\" alt=\"\"> اجرا <span style=\"font-size:11px;opacity:.85\">Ctrl+Enter</span></button>\n  <button class=\"tbtn\" id=\"themeBtn\"><img class=\"cicon\" id=\"themeIc\" src=\"../ide_static/icons/moon.webp\" alt=\"\"><span id=\"themeLbl\">تم تیره</span></button>\n</header>\n\n<div class=\"tabbar\">\n  <button class=\"tabbtn2 on\" id=\"tabDesigner\">طراح فرم</button>\n  <button class=\"tabbtn2\" id=\"tabCode\"><img class=\"cicon\" src=\"../ide_static/icons/keyboard.webp\" alt=\"\">کد</button>\n</div>\n\n<main>\n  <!-- ── نمای طراح ── -->\n  <div class=\"view on\" id=\"viewDesigner\">\n    <div class=\"designer\">\n      <div class=\"panel\">\n        <h3><img class=\"cicon\" src=\"../ide_static/icons/file.webp\" alt=\"\">جعبه‌ابزار</h3>\n        <div class=\"tools\">\n          <div class=\"tool\" data-type=\"دکمه\"><span class=\"tico\" style=\"background:linear-gradient(135deg,#7048E8,#9775FA)\">ب</span>دکمه</div>\n          <div class=\"tool\" data-type=\"برچسب\"><span class=\"tico\" style=\"background:#0CA678\">م</span>برچسب</div>\n          <div class=\"tool\" data-type=\"کادر\"><span class=\"tico\" style=\"background:#3B82F6\">▭</span>کادر متنی</div>\n        </div>\n        <div class=\"pnote\" style=\"padding:0 14px 12px\">روی ابزار کلیک کن، بعد روی <b>بوم فرم</b> کلیک کن تا کنترل بیفته. برای جابه‌جایی بکشش.</div>\n      </div>\n\n      <div class=\"canvas-wrap\">\n        <div class=\"form-window\" id=\"formWindow\">\n          <div class=\"form-title\" id=\"formTitle\">برنامه من</div>\n          <div id=\"canvas\" style=\"position:relative;width:340px;height:206px\"></div>\n        </div>\n      </div>\n\n      <div class=\"panel\">\n        <h3><img class=\"cicon\" src=\"../ide_static/icons/bulb.webp\" alt=\"\">مشخصات</h3>\n        <div class=\"props\" id=\"ctrlProps\" style=\"display:none\">\n          <div class=\"prow\"><label>نام کنترل (برای رویداد)</label><input id=\"pName\" spellcheck=\"false\"></div>\n          <div class=\"prow\"><label>متن</label><input id=\"pText\"></div>\n          <div class=\"prow\"><label>X — از راست</label><input id=\"pX\" type=\"number\"></div>\n          <div class=\"prow\"><label>Y — از بالا</label><input id=\"pY\" type=\"number\"></div>\n          <div class=\"pnote\">دبل‌کلیک روی کنترل توی بوم → استاب رویداد کلیک توی تب کد ساخته می‌شه.</div>\n        </div>\n        <div class=\"props\" id=\"formProps\">\n          <div class=\"prow\"><label>عنوان پنجره</label><input id=\"fTitle\"></div>\n          <div class=\"prow\"><label>پهنا</label><input id=\"fW\" type=\"number\"></div>\n          <div class=\"prow\"><label>ارتفاع</label><input id=\"fH\" type=\"number\"></div>\n          <div class=\"pnote\">روی کنترل‌ها کلیک کنی مشخصاتشون اینجا میاد. بدون انتخاب = مشخصات خود پنجره.</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ── نمای کد ── -->\n  <div class=\"view\" id=\"viewCode\">\n    <div class=\"panel\" style=\"border-radius:16px 16px 0 0;border-bottom:0\">\n      <div class=\"toolbar\" style=\"display:flex;gap:8px;padding:10px 14px;border-bottom:1px solid var(--line);align-items:center\">\n        <span style=\"font-size:13px;color:var(--muted);font-weight:700\">کد گویا — بخش فرم رو دست نزن، طراح خودش به‌روز می‌کنه</span>\n      </div>\n      <div class=\"editor-wrap\" style=\"border-radius:0\">\n        <div class=\"gutter\" id=\"gutter\"></div>\n        <div class=\"code-area\">\n          <pre id=\"hl\" class=\"code-layer\" aria-hidden=\"true\"></pre>\n          <textarea id=\"codeTa\" class=\"code-layer\" spellcheck=\"false\" autocapitalize=\"off\" autocomplete=\"off\"></textarea>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"out-card\">\n    <div style=\"padding:10px 16px 0;font-size:13px;font-weight:800\">خروجی</div>\n    <pre id=\"out\">با دکمه‌ی اجرا، برنامه‌ات بالا میاد؛ پیام‌ها و خطاهاش اینجا نمایش داده می‌شه.</pre>\n  </div>\n</main>\n\n<div class=\"hintbar\" style=\"position:relative;z-index:1;max-width:1500px;margin:0 auto;padding:6px 22px 14px\">\n  <span id=\"status\">آماده</span>\n  <span>Ctrl+Enter اجرا • Ctrl+S ذخیره • کد خودکار ذخیره می‌شه</span>\n</div>\n\n<script>\n\"use strict\";\nconst $ = id => document.getElementById(id);\n\n/* ───────── وضعیت پروژه ───────── */\nconst TYPES = {\n  \"دکمه\":   {w: 120, h: 34,  cls: \"btn-c\",   factory: \"دکمه\"},\n  \"برچسب\":  {w: 140, h: 26,  cls: \"label-c\", factory: \"برچسب\"},\n  \"کادر\":   {w: 160, h: 32,  cls: \"entry-c\", factory: \"کادر\"},\n};\nconst state = {\n  form: {title: \"برنامه من\", w: 340, h: 240},\n  controls: [],   // {id, type, name, text, x, y}\n  seq: {دکمه: 0, برچسب: 0, کادر: 0},\n  selected: null, // id\n};\nlet projPath = \"\";\n\n/* ───────── رنگ‌آمیزی کد ───────── */\nconst KW = new Set([\"اگر\",\"وگرنه\",\"تا\",\"وقتی\",\"که\",\"برای\",\"هر\",\"از\",\"در\",\"تابع\",\"برگردان\",\"بشکن\",\"ادامه\"]);\nconst VAL = new Set([\"درست\",\"غلط\",\"پوچ\"]);\nconst OP1 = new Set([\"برابر\",\"نابرابر\",\"ضربدر\",\"باقیمانده\"]);\nconst BIO = new Set([\"بزرگتر\",\"کوچکتر\"]);\nconst BUILT = new Set([\"بگو\",\"بنویس\",\"بپرس\",\"بگیر\",\"طول\",\"عدد\",\"متن\",\"گرد\",\"تصادفی\",\"امروز\",\"فرم\",\"دکمه\",\"برچسب\",\"کادر\",\"پیام\"]);\nconst strip = s => s.replace(/\\u200c/g,\"\");\nconst TOKEN_RE = /(\"(?:[^\"\\\\\\n]|\\\\.)*\"?|«[^»]*»?|#[^\\n]*|[0-9\\u06F0-\\u06F9\\u0660-\\u0669]+(?:[.٫][0-9\\u06F0-\\u06F9\\u0660-\\u0669]+)?|[\\u0600-\\u06FF\\u200c_]+|\\n|[^\\S\\n]+|[\\s\\S])/g;\nfunction esc(s){return s.replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\");}\nfunction highlight(code){\n  const toks=[]; let m; TOKEN_RE.lastIndex=0;\n  while((m=TOKEN_RE.exec(code))!==null){\n    const t=m[0]; let cls=\"plain\";\n    if(t[0]===\"#\")cls=\"cmt\";\n    else if(t[0]==='\"'||t[0]===\"«\")cls=\"str\";\n    else if(/^[0-9\\u06F0-\\u06F9\\u0660-\\u0669]/.test(t))cls=\"num\";\n    else if(/^[\\u0600-\\u06FF\\u200c_]+$/.test(t))cls=\"fa\";\n    toks.push({t,cls});\n  }\n  const fa=i=>toks[i]&&toks[i].cls===\"fa\";\n  const w=i=>toks[i]?strip(toks[i].t):\"\";\n  for(let i=0;i<toks.length;i++){\n    if(!fa(i))continue;\n    const x=w(i);\n    if(x===\"تا\"&&w(i+1)===\"وقتی\"&&w(i+2)===\"که\"){toks[i].cls=toks[i+1].cls=toks[i+2].cls=\"kw\";i+=2;continue;}\n    if(x===\"برای\"&&w(i+1)===\"هر\"){toks[i].cls=toks[i+1].cls=\"kw\";i++;continue;}\n    if(BIO.has(x)&&(w(i+1)===\"از\"||w(i+1)===\"مساوی\")){toks[i].cls=toks[i+1].cls=\"opw\";i++;continue;}\n    if((x===\"از\"||x===\"مساوی\")&&BIO.has(w(i-1))){toks[i].cls=\"opw\";continue;}\n    if(x===\"تقسیم\"&&w(i+1)===\"بر\"){toks[i].cls=toks[i+1].cls=\"opw\";i++;continue;}\n    if(x===\"بر\"&&w(i-1)===\"تقسیم\"){toks[i].cls=\"opw\";continue;}\n    if(KW.has(x)||VAL.has(x))toks[i].cls=\"kw\";\n    else if(OP1.has(x))toks[i].cls=\"opw\";\n    else if(BUILT.has(x))toks[i].cls=\"built\";\n  }\n  return toks.map(t=>t.cls===\"plain\"?esc(t.t):'<span class=\"tk-'+t.cls+'\">'+esc(t.t)+'</span>').join(\"\")+\"\\n\";\n}\n\n/* ───────── تب‌ها ───────── */\nfunction showTab(which){\n  $(\"viewDesigner\").className = \"view\" + (which===\"designer\" ? \" on\" : \"\");\n  $(\"viewCode\").className = \"view\" + (which===\"code\" ? \" on\" : \"\");\n  $(\"tabDesigner\").className = \"tabbtn2\" + (which===\"designer\" ? \" on\" : \"\");\n  $(\"tabCode\").className = \"tabbtn2\" + (which===\"code\" ? \" on\" : \"\");\n}\n$(\"tabDesigner\").onclick = () => showTab(\"designer\");\n$(\"tabCode\").onclick = () => { syncCodeFromState(); showTab(\"code\"); };\n\n/* ───────── طراح ───────── */\nconst canvas = $(\"canvas\");\nconst faNum = n => String(n).replace(/[0-9]/g, d => \"۰۱۲۳۴۵۶۷۸۹\"[d]);\nconst latin = s => String(s).replace(/[۰-۹]/g, d => \"۰۱۲۳۴۵۶۷۸۹\".indexOf(d));\n\nfunction renderCanvas(){\n  canvas.innerHTML = \"\";\n  canvas.style.width = state.form.w + \"px\";\n  canvas.style.height = (state.form.h - 34) + \"px\";\n  $(\"formWindow\").style.width = state.form.w + \"px\";\n  $(\"formTitle\").textContent = state.form.title;\n  state.controls.forEach(c => {\n    const t = TYPES[c.type];\n    const el = document.createElement(\"div\");\n    el.className = \"ctrl \" + t.cls + (state.selected === c.id ? \" sel\" : \"\");\n    el.style.cssText = \"right:\" + c.x + \"px;top:\" + c.y + \"px;width:\" + t.w + \"px;height:\" + t.h + \"px\";\n    el.textContent = c.text;\n    el.dataset.id = c.id;\n    if (c.type === \"کادر\") el.textContent = c.text;\n    el.onmousedown = e => startDrag(e, c.id);\n    el.ondblclick = () => { select(c.id); ensureStub(c); showTab(\"code\"); };\n    canvas.appendChild(el);\n  });\n}\n\nfunction select(id){\n  state.selected = id;\n  renderCanvas(); renderProps();\n}\nfunction renderProps(){\n  const c = state.controls.find(x => x.id === state.selected);\n  if (!c){ $(\"ctrlProps\").style.display = \"none\"; $(\"formProps\").style.display = \"block\"; bindFormProps(); return; }\n  $(\"ctrlProps\").style.display = \"flex\"; $(\"formProps\").style.display = \"none\";\n  $(\"pName\").value = c.name; $(\"pText\").value = c.text;\n  $(\"pX\").value = latin(String(c.x)); $(\"pY\").value = latin(String(c.y));\n}\nlet formBindArmed = false;\nfunction bindFormProps(){\n  if (formBindArmed) return; formBindArmed = true;\n  $(\"fTitle\").oninput = () => { state.form.title = $(\"fTitle\").value; renderCanvas(); saveSoon(); };\n  $(\"fW\").oninput = () => { state.form.w = Number(latin($(\"fW\").value)) || 340; renderCanvas(); saveSoon(); };\n  $(\"fH\").oninput = () => { state.form.h = Number(latin($(\"fH\").value)) || 240; renderCanvas(); saveSoon(); };\n  $(\"pName\").oninput = () => { const c = cur(); if (c){ c.name = $(\"pName\").value; saveSoon(); } };\n  $(\"pText\").oninput = () => { const c = cur(); if (c){ c.text = $(\"pText\").value; renderCanvas(); saveSoon(); } };\n  $(\"pX\").oninput = () => { const c = cur(); if (c){ c.x = Number(latin($(\"pX\").value)) || 0; renderCanvas(); saveSoon(); } };\n  $(\"pY\").oninput = () => { const c = cur(); if (c){ c.y = Number(latin($(\"pY\").value)) || 0; renderCanvas(); saveSoon(); } };\n}\nfunction cur(){ return state.controls.find(x => x.id === state.selected); }\n\n/* کلیک روی بوم (خارج کنترل‌ها) → لغو انتخاب */\ncanvas.onmousedown = e => {\n  if (e.target === canvas){ state.selected = null; renderCanvas(); renderProps(); }\n};\n\n/* جعبه‌ابزار: کلیک → افزودن کنترل */\ndocument.querySelectorAll(\".tool\").forEach(tl => {\n  tl.onclick = () => {\n    const type = tl.dataset.type;\n    const n = ++state.seq[type];\n    const base = type + \"_\" + faNum(n);\n    const c = { id: type + \"_\" + Date.now(), type, name: base, text: type === \"کادر\" ? \"\" : type + \" \" + faNum(n), x: 24, y: 24 + (n % 5) * 12 };\n    state.controls.push(c);\n    select(c.id); saveSoon();\n    tl.classList.add(\"placing\"); setTimeout(() => tl.classList.remove(\"placing\"), 350);\n  };\n});\n\n/* درگ جابه‌جایی */\nlet drag = null;\nfunction startDrag(e, id){\n  e.stopPropagation();\n  select(id);\n  const c = state.controls.find(x => x.id === id);\n  drag = { id, sx: e.clientX, sy: e.clientY, ox: c.x, oy: c.y };\n}\ndocument.addEventListener(\"mousemove\", e => {\n  if (!drag) return;\n  const c = state.controls.find(x => x.id === drag.id);\n  if (!c) return;\n  const snap = v => Math.round(v / 8) * 8;\n  c.x = Math.max(0, Math.min(state.form.w - 60, snap(drag.ox - (e.clientX - drag.sx))));\n  c.y = Math.max(0, Math.min(state.form.h - 80, snap(drag.oy + (e.clientY - drag.sy))));\n  renderCanvas(); renderProps();\n});\ndocument.addEventListener(\"mouseup\", () => { if (drag){ drag = null; saveSoon(); } });\n\n/* ───────── تولید کد گویا ───────── */\nfunction generateGoya(){\n  const L = [];\n  L.push(\"## ┌── بخش فرم (تولیدشده توسط گویا استودیو) ──┐\");\n  L.push('پنجره = فرم(\"' + state.form.title + '\"، ' + faNum(state.form.w) + '، ' + faNum(state.form.h) + ')');\n  state.controls.forEach(c => {\n    L.push(c.name + \" = \" + TYPES[c.type].factory + '(\"' + c.text + '\"، ' + faNum(c.x) + '، ' + faNum(c.y) + ')');\n  });\n  L.push(\"## └── بخش کد ──┘\");\n  L.push(\"\");\n  L.push(codeText);\n  return L.join(\"\\n\");\n}\n\n/* بازخوانی پروژه از متن .goya */\nfunction parseProject(text){\n  const lines = text.split(\"\\n\");\n  state.controls = []; state.seq = {دکمه: 0, برچسب: 0, کادر: 0}; state.selected = null;\n  let codeStarted = false;\n  const codeLines = [];\n  const re = /^(\\S+)\\s*=\\s*(فرم|دکمه|برچسب|کادر)\\(\"(.*)\"\\s*،\\s*([۰-۹0-9]+)\\s*،\\s*([۰-۹0-9]+)\\)\\s*$/;\n  for (const raw of lines){\n    if (!codeStarted && raw.includes(\"بخش کد\")){ codeStarted = true; continue; }\n    if (!codeStarted){\n      const m = raw.match(re);\n      if (m){\n        const varName = m[1], factory = m[2], txt = m[3];\n        const x = Number(latin(m[4])), y = Number(latin(m[5]));\n        if (factory === \"فرم\"){\n          state.form = {title: txt, w: x, h: y};\n        } else {\n          state.seq[factory] = (state.seq[factory] || 0) + 1;\n          state.controls.push({id: factory + \"_\" + Date.now() + \"_\" + state.seq[factory], type: factory, name: varName, text: txt, x, y});\n        }\n        continue;\n      }\n      if (raw.trim() === \"\" || raw.trim().startsWith(\"#\")) continue;\n    }\n    if (codeStarted) codeLines.push(raw);\n  }\n  codeText = codeLines.join(\"\\n\").replace(/^\\n+/, \"\");\n  if (!state.controls.length && !state.form.title) state.form = {title: \"برنامه من\", w: 340, h: 240};\n  renderCanvas(); renderProps();\n  $(\"codeTa\").value = codeText; updateCode();\n}\n\n/* ───────── ادیتور کد ───────── */\nconst ta = $(\"codeTa\"), hl = $(\"hl\"), gutter = $(\"gutter\");\nlet codeText = \"\";\nfunction updateCode(){\n  hl.innerHTML = highlight(ta.value);\n  hl.scrollTop = ta.scrollTop; hl.scrollLeft = ta.scrollLeft;\n  const n = ta.value.split(\"\\n\").length;\n  if (gutter.childElementCount !== n){\n    let h = \"\"; for (let i = 1; i <= n; i++) h += \"<div>\" + faNum(i) + \"</div>\";\n    gutter.innerHTML = h;\n  }\n  gutter.scrollTop = ta.scrollTop;\n}\nta.addEventListener(\"input\", () => { codeText = ta.value; updateCode(); saveSoon(); });\nta.addEventListener(\"scroll\", () => { hl.scrollTop = ta.scrollTop; hl.scrollLeft = ta.scrollLeft; gutter.scrollTop = ta.scrollTop; });\nta.addEventListener(\"keydown\", e => {\n  if (e.key === \"Tab\"){\n    e.preventDefault();\n    ta.setRangeText(\"    \", ta.selectionStart, ta.selectionEnd, \"end\");\n    codeText = ta.value; updateCode(); return;\n  }\n  if (e.key === \"Enter\" && !e.shiftKey && !e.ctrlKey){\n    e.preventDefault();\n    const p = ta.selectionStart, ls = ta.value.lastIndexOf(\"\\n\", p - 1) + 1;\n    const indent = (ta.value.slice(ls, p).match(/^[ ]*/) || [\"\"])[0];\n    ta.setRangeText(\"\\n\" + indent, ta.selectionStart, ta.selectionEnd, \"end\");\n    codeText = ta.value; updateCode();\n  }\n});\nfunction syncCodeFromState(){ ta.value = codeText; updateCode(); }\n\n/* استاب رویداد در دبل‌کلیک */\nfunction ensureStub(c){\n  const fnName = c.name + \"_کلیک\";\n  if (codeText.includes(\"تابع \" + fnName)) return;\n  if (codeText.trim()) codeText += \"\\n\\n\";\n  codeText += \"تابع \" + fnName + \"()\\n    \\n\";\n  $(\"codeTa\").value = codeText; updateCode();\n}\n\n/* ───────── ذخیره / باز / جدید / اجرا ───────── */\nconst statusEl = $(\"status\");\nfunction setStatus(t){ statusEl.textContent = t; }\nfunction generateProjectText(){ return generateGoya(); }\n\n$(\"runBtn\").onclick = doRun;\nasync function doRun(){\n  const code = generateProjectText();\n  setStatus(\"در حال اجرا…\");\n  $(\"out\").textContent = \"\";\n  try{\n    const res = await window.pywebview.api.run(code);\n    if (res && res.ok === false && res.err){ $(\"out\").textContent = res.err; setStatus(\"خطای نگارشی\"); }\n    else setStatus(\"پنجره‌ی برنامه باز شد\");\n  }catch(e){ setStatus(\"خطا: \" + e); }\n}\nfunction studioAppendOut(text){\n  $(\"out\").textContent += text + \"\\n\";\n  $(\"out\").scrollTop = $(\"out\").scrollHeight;\n}\nwindow.studioAppendOut = studioAppendOut;\n\n$(\"saveBtn\").onclick = doSave;\nasync function doSave(){\n  const content = generateProjectText();\n  try{\n    const res = await window.pywebview.api.save_project(content);\n    if (res && res.ok){ projPath = res.path; $(\"projName\").value = res.path.split(/[\\\\/]/).pop(); setStatus(\"ذخیره شد: \" + res.path); }\n    else setStatus(\"ذخیره لغو شد\");\n  }catch(e){ setStatus(\"خطا در ذخیره\"); }\n}\n$(\"openBtn\").onclick = doOpen;\nasync function doOpen(){\n  try{\n    const res = await window.pywebview.api.open_project();\n    if (res && res.ok){ projPath = res.path; $(\"projName\").value = res.path.split(/[\\\\/]/).pop(); parseProject(res.content); showTab(\"designer\"); setStatus(\"پروژه باز شد: \" + res.path); }\n    else setStatus(\"باز کردن لغو شد\");\n  }catch(e){ setStatus(\"خطا در باز کردن\"); }\n}\n$(\"newBtn\").onclick = () => {\n  state.form = {title: \"برنامه من\", w: 340, h: 240};\n  state.controls = []; state.selected = null;\n  state.seq = {دکمه: 0, برچسب: 0, کادر: 0};\n  codeText = \"\"; $(\"codeTa\").value = \"\"; projPath = \"\"; $(\"projName\").value = \"برنامه بدون نام\";\n  renderCanvas(); renderProps(); updateCode(); setStatus(\"پروژه جدید\");\n};\ndocument.addEventListener(\"keydown\", e => {\n  if ((e.ctrlKey || e.metaKey) && e.key === \"Enter\"){ e.preventDefault(); doRun(); }\n  if ((e.ctrlKey || e.metaKey) && e.key === \"s\"){ e.preventDefault(); doSave(); }\n});\n\n/* ───────── تم ───────── */\n$(\"themeBtn\").onclick = () => {\n  const dark = document.body.getAttribute(\"data-theme\") === \"dark\";\n  document.body.setAttribute(\"data-theme\", dark ? \"\" : \"dark\");\n  $(\"themeIc\").src = dark ? \"../ide_static/icons/moon.webp\" : \"../ide_static/icons/sun.webp\";\n  $(\"themeLbl\").textContent = dark ? \"تم تیره\" : \"تم روشن\";\n  try{ localStorage.setItem(\"goya-studio-theme\", dark ? \"\" : \"dark\"); }catch(e){}\n};\n\n/* ───────── شروع ───────── */\n(async function init(){\n  try{\n    if (localStorage.getItem(\"goya-studio-theme\") === \"dark\"){\n      document.body.setAttribute(\"data-theme\", \"dark\");\n      $(\"themeIc\").src = \"../ide_static/icons/sun.webp\";\n      $(\"themeLbl\").textContent = \"تم روشن\";\n    }\n  }catch(e){}\n  try{\n    const init = await window.pywebview.api.load_initial();\n    if (init.ok && init.content){ parseProject(init.content); $(\"projName\").value = (init.path.split(/[\\\\/]/).pop() || \"پروژه\"); setStatus(\"پروژه باز شد\"); return; }\n  }catch(e){}\n  // پروژه‌ی شروع: ماشین‌حساب نمونه\n  parseProject(\n    '## ┌── بخش فرم (تولیدشده توسط گویا استودیو) ──┐\\n' +\n    'پنجره = فرم(\"ماشین‌حساب گویا\"، ۳۴۰، ۲۴۰)\\n' +\n    'عدد۱ = کادر(\"عدد اول\"، ۲۰، ۲۰)\\n' +\n    'عدد۲ = کادر(\"عدد دوم\"، ۲۰، ۷۰)\\n' +\n    'محاسبه = دکمه(\"محاسبه کن\"، ۲۰، ۱۲۰)\\n' +\n    'نتیجه = برچسب(\"جواب اینجا میاد…\", ۲۰، ۱۷۰)\\n' +\n    '## └── بخش کد ──┘\\n' +\n    'تابع محاسبه_کلیک()\\n' +\n    '    الف = عدد(عدد۱.متن)\\n' +\n    '    ب = عدد(عدد۲.متن)\\n' +\n    '    نتیجه.متن = \"جواب: \" + متن(الف + ب)\\n'\n  );\n  setStatus(\"پروژه نمونه آماده‌ست — بکش، بنداز، اجرا کن!\");\n})();\n</script>\n</body>\n</html>\n"