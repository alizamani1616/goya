## گران‌ترین و میانگین — کار با لیست اعداد
قیمت‌ها = [۱۲۰۰۰، ۴۵۰۰۰، ۸۵۰۰، ۹۹۰۰۰، ۳۳۰۰۰]

بزرگ‌ترین = قیمت‌ها[۰]
جمع = ۰

برای هر قیمت در قیمت‌ها
    اگر قیمت بزرگتر از بزرگ‌ترین
        بزرگ‌ترین = قیمت
    جمع = جمع + قیمت

میانگین = جمع / طول(قیمت‌ها)

بگو("تعداد اقلام: "، طول(قیمت‌ها))
بگو("گران‌ترین: "، بزرگ‌ترین، "تومان")
بگو("میانگین: "، گرد(میانگین)، "تومان")
