## فصل سال — از روی شماره ماه شمسی
ماه = عدد(بپرس("شماره ماه (۱ تا ۱۲): "))

اگر ماه < ۱ یا ماه > ۱۲
    بگو("ماه باید بین ۱ تا ۱۲ باشه!")
وگرنه اگر ماه <= ۳
    بگو("بهار 🌸 — نوروز نزدیکه!")
وگرنه اگر ماه <= ۶
    بگو("تابستان ☀️")
وگرنه اگر ماه <= ۹
    بگو("پاییز 🍂")
وگرنه
    بگو("زمستان ❄️ — یلدا هم همین‌وسطه!")
