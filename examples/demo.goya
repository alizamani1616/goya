## ────────────────────────────────────────
##  تور گویا: همه‌ی قابلیت‌ها در یک برنامه
## ────────────────────────────────────────

## ۱) متغیر — با هر دو گیومه، ارقام فارسی/لاتین، و اسم با نیم‌فاصله
نام‌مغازه = «فروشگاه علی»
سال_تاسیس = 1405          ## رقم لاتین هم قبوله

## ۲) تابع ساده با برگشت مقدار
تابع جمع(الف، ب)
    برگردان الف + ب

## ۳) تابع بازگشتی (خودش رو صدا می‌زنه)
تابع فاکتوریل(عدد)
    اگر عدد <= ۱
        برگردان ۱
    برگردان عدد * فاکتوریل(عدد - ۱)

## ۴) لیست + حلقه «در» + ویرگول فارسی
قیمت‌ها = [۲۵۰۰۰، ۴۰۰۰۰، ۱۸۵۰۰]
جمع‌کل = ۰
برای هر قیمت در قیمت‌ها
    جمع‌کل = جمع‌کل + قیمت

## ۵) شرط با اپراتور کلمه‌ای «بزرگتر از»
اگر جمع‌کل بزرگتر از ۵۰۰۰۰
    تخفیف = جمع‌کل / ۱۰
وگرنه
    تخفیف = ۰

## ۶) نمایش
بگو("=== " + نام‌مغازه + " ===")
بگو("سال تاسیس: " + متن(سال_تاسیس))
بگو("جمع فاکتور: " + متن(جمع‌کل) + " تومان")
اگر تخفیف > ۰
    بگو("تخفیف: " + متن(گرد(تخفیف)) + " تومان")
    بگو("قابل پرداخت: " + متن(جمع‌کل - گرد(تخفیف)) + " تومان")

## ۷) حلقه «تا وقتی که»
شمارنده = ۳
تا وقتی که شمارنده > ۰
    بگو("تا افتتاح: " + متن(شمارنده) + "...")
    شمارنده = شمارنده - ۱

## ۸) کتابخانه داخلی — شمسی، تصادفی، متن
بگو("امروز: " + امروز())
بگو("یک تاس بینداز: " + متن(تصادفی(۱، ۶)))
بگو("طول اسم مغازه: " + متن(طول(نام‌مغازه)) + " حرف")
بگو("۵ فاکتوریل می‌شه: " + متن(فاکتوریل(۵)))
بگو("گردِ ۹٫۲۵ می‌شه: " + متن(گرد(۹٫۲۵)))
