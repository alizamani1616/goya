## بازی حدس عدد — بین ۱ تا ۱۰۰
هدف = تصادفی(۱، ۱۰۰)
تعداد = ۰

بگو("یه عدد بین ۱ تا ۱۰۰ تو ذهنم گذاشتم... حدس بزن!")

تا وقتی که درست
    حدس = عدد(بپرس("حدست؟ "))
    تعداد = تعداد + ۱
    اگر حدس < هدف
        بگو("برو بالاتر ⬆")
    وگرنه اگر حدس > هدف
        بگو("بیا پایین‌تر ⬇")
    وگرنه
        بگو("آفرین! با " + متن(تعداد) + " حدس پیداش کردی 🎉")
        بشکن
