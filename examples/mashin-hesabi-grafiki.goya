## ماشین‌حساب گرافیکی — اولین پنجره‌ی گویا
## اجرا:  python -m goya run examples/mashin-hesabi-grafiki.goya
پنجره = فرم("ماشین‌حساب گویا"، ۳۴۰، ۲۴۰)

عدد۱ = کادر("عدد اول"، ۲۰، ۲۰)
عدد۲ = کادر("عدد دوم"، ۲۰، ۷۰)
محاسبه = دکمه("محاسبه کن"، ۲۰، ۱۲۰)
نتیجه = برچسب("جواب اینجا میاد…", ۲۰، ۱۷۰)

## جادوی وی‌بی: اسم دکمه «محاسبه» است — پس تابع محاسبه_کلیک خودکار وصل می‌شه
تابع محاسبه_کلیک()
    الف = عدد(عدد۱.متن)
    ب = عدد(عدد۲.متن)
    نتیجه.متن = "جواب: " + متن(الف + ب)
