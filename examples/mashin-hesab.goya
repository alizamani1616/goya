## ماشین‌حساب ساده — دو عدد و یک عمل
عدد_اول = عدد(بپرس("عدد اول: "))
عمل = بپرس("عمل (+ - * /): ")
عدد_دوم = عدد(بپرس("عدد دوم: "))

جواب = ۰
شناخته = درست

اگر عمل == "+"
    جواب = عدد_اول + عدد_دوم
وگرنه اگر عمل == "-"
    جواب = عدد_اول - عدد_دوم
وگرنه اگر عمل == "*"
    جواب = عدد_اول * عدد_دوم
وگرنه اگر عمل == "/"
    اگر عدد_دوم == ۰
        بگو("تقسیم بر صفر که نمی‌شه!")
        شناخته = غلط
    وگرنه
        جواب = عدد_اول / عدد_دوم
وگرنه
    بگو("این عمل رو نمی‌شناسم!")
    شناخته = غلط

اگر شناخته
    بگو("جواب: " + متن(جواب))
